DJANGO_SECRET_KEY=replace-this-with-real-secret
DJANGO_DEBUG=true
# Add the host LAN IP when testing from a phone, for example: 127.0.0.1,localhost,192.168.3.10
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DATABASE_URL=postgres://sunshine_user:sunshine_password@localhost:5432/sunshine_reading

# Redis target config (reserved)
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_KEY_PREFIX=sunshine-reading

# CORS. Add the LAN frontend origin for phone testing, for example: http://192.168.3.10:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Time zone
TIME_ZONE=Asia/Shanghai
