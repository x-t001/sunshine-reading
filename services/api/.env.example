DJANGO_SECRET_KEY=replace-this-with-real-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL target config (optional in current stage)
DB_ENGINE=sqlite
DB_NAME=sunshine_reading
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis target config (reserved)
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_KEY_PREFIX=sunshine-reading

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Time zone
TIME_ZONE=Asia/Shanghai

# Server-side OpenAI-compatible provider for short-video storyboards.
VIDEO_AI_API_URL=https://api.openai.com/v1/chat/completions
VIDEO_AI_API_KEY=
VIDEO_AI_MODEL=gpt-4o-mini
VIDEO_AI_TIMEOUT_SECONDS=60
VIDEO_JOB_MAX_ATTEMPTS=3
VIDEO_JOB_POLL_INTERVAL_SECONDS=2
VIDEO_JOB_STALE_SECONDS=300
