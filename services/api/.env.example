DJANGO_SECRET_KEY=replace-this-with-real-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL target config (optional in current stage)
DB_ENGINE=sqlite
DB_NAME=sunshine_reading
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis target config (reserved)
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_KEY_PREFIX=sunshine-reading

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Time zone
TIME_ZONE=Asia/Shanghai

# Server-side OpenAI-compatible provider for short-video storyboards.
VIDEO_AI_API_URL=https://api.openai.com/v1/chat/completions
VIDEO_AI_API_KEY=
VIDEO_AI_MODEL=gpt-4o-mini
VIDEO_AI_TIMEOUT_SECONDS=60
# 复杂制作设定与原子镜头 JSON 使用独立超时，且不得低于通用超时。
VIDEO_AI_PLANNING_TIMEOUT_SECONDS=180
VIDEO_AI_DIRECTING_TIMEOUT_SECONDS=180
# GLM-4.7 默认开启 Thinking；结构化分镜建议设为 disabled。其他供应商不支持时留空。
VIDEO_AI_THINKING_TYPE=

# 短视频镜头画面生成。未单独设置 Key 时，运行配置会复用 VIDEO_AI_API_KEY。
VIDEO_IMAGE_API_URL=https://open.bigmodel.cn/api/paas/v4/images/generations
VIDEO_IMAGE_API_KEY=
VIDEO_IMAGE_MODEL=glm-image
VIDEO_IMAGE_SIZE=960x1728
VIDEO_IMAGE_TIMEOUT_SECONDS=90
VIDEO_IMAGE_DAILY_JOB_LIMIT=3

# 短视频逐镜动态画面。未单独设置 Key 时，运行配置会复用 VIDEO_AI_API_KEY。
VIDEO_CLIP_API_URL=https://open.bigmodel.cn/api/paas/v4/videos/generations
VIDEO_CLIP_RESULT_API_URL=https://open.bigmodel.cn/api/paas/v4/async-result/{task_id}
VIDEO_CLIP_API_KEY=
VIDEO_CLIP_MODEL=cogvideox-flash
VIDEO_CLIP_SIZE=1080x1920
# CogVideoX-Flash 当前接口固定按模型默认时长生成；该字段仅对支持 duration 的模型生效。
VIDEO_CLIP_DURATION_SECONDS=5
VIDEO_CLIP_FPS=30
# 模型内嵌音频不可作为清晰旁白，默认关闭；环境音应在最终混音阶段单独处理。
VIDEO_CLIP_WITH_AUDIO=false
# 优先使用同一分镜已就绪的 PNG/JPEG 作为图生视频首帧；缺少兼容图片时自动回退到文生视频。
VIDEO_CLIP_USE_SCENE_IMAGE=true
# 从成功视频提取尾帧，并优先作为下一镜的起始参考；不可用时回退到本镜静态图。
VIDEO_CLIP_USE_PREVIOUS_TAIL_FRAME=true
VIDEO_CLIP_REFERENCE_IMAGE_MAX_FILE_BYTES=5242880
VIDEO_CLIP_TAIL_FRAME_TIMEOUT_SECONDS=30
VIDEO_CLIP_REQUEST_TIMEOUT_SECONDS=30
VIDEO_CLIP_POLL_INTERVAL_SECONDS=5
VIDEO_CLIP_MAX_WAIT_SECONDS=900
VIDEO_CLIP_MAX_FILE_BYTES=104857600
VIDEO_CLIP_DAILY_JOB_LIMIT=1
# 人工视觉复核后的局部重拍额度；按实际重拍镜头数计数，不占整批任务额度。
VIDEO_VISUAL_REGENERATION_DAILY_SCENE_LIMIT=6
VIDEO_VISUAL_REGENERATION_PER_SCENE_LIMIT=2

# 短视频旁白配音。未单独设置 Key 时，运行配置会复用 VIDEO_AI_API_KEY。
VIDEO_TTS_API_URL=https://open.bigmodel.cn/api/paas/v4/audio/speech
VIDEO_TTS_API_KEY=
VIDEO_TTS_MODEL=glm-tts
VIDEO_TTS_VOICE=tongtong
VIDEO_TTS_SPEED=1.0
VIDEO_TTS_VOLUME=1.0
VIDEO_TTS_TIMEOUT_SECONDS=90
VIDEO_TTS_DAILY_JOB_LIMIT=5

# 可选语音转写质检。默认关闭以避免隐式增加模型费用；开启后未单独设置 Key 时复用 VIDEO_TTS_API_KEY。
VIDEO_ASR_ENABLED=false
VIDEO_ASR_API_URL=https://open.bigmodel.cn/api/paas/v4/audio/transcriptions
VIDEO_ASR_API_KEY=
VIDEO_ASR_MODEL=glm-asr-2512
VIDEO_ASR_TIMEOUT_SECONDS=60
VIDEO_ASR_MIN_SIMILARITY=0.75
VIDEO_ASSET_MAX_FILE_BYTES=26214400

# 本地成片渲染。FFmpeg 由 imageio-ffmpeg 提供，也可通过 IMAGEIO_FFMPEG_EXE 指定系统版本。
VIDEO_RENDER_ENABLED=true
VIDEO_RENDER_WIDTH=720
VIDEO_RENDER_HEIGHT=1280
VIDEO_RENDER_FPS=30
VIDEO_RENDER_CRF=21
VIDEO_RENDER_TIMEOUT_SECONDS=600
VIDEO_RENDER_MAX_FILE_BYTES=524288000

VIDEO_JOB_MAX_ATTEMPTS=3
VIDEO_JOB_POLL_INTERVAL_SECONDS=2
VIDEO_JOB_STALE_SECONDS=300
